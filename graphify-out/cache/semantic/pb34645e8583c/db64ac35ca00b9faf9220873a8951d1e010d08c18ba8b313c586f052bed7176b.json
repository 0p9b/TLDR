{"nodes": [{"id": "data_changelog_blunt_v0180", "label": "TLDR.blunt.md v0.18.0 (DSPy round-2 winner)", "file_type": "concept", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_changelog_blunt_v0150", "label": "TLDR.blunt.md v0.15.0 (anti-sycophancy variant)", "file_type": "concept", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_changelog_dspy_instruction_evolution", "label": "DSPy-style instruction evolution", "file_type": "concept", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_changelog_cross_model_held_out", "label": "5-agent cross-model held-out evaluation", "file_type": "concept", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_changelog_independent_judge_codex", "label": "Codex independent judge", "file_type": "concept", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_changelog_prepend_to_user_message", "label": "Prepend-to-user-message injection", "file_type": "concept", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only claude exposes --append-system-prompt; prepending gives one uniform injection method across agents, at the documented cost of not matching real memory-file deployment."}, {"id": "data_changelog_anti_contrarian", "label": "Anti-contrarian pushback rule", "file_type": "rationale", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v0.17.0 pushed back too readily on correct users (cursor agree-rate 0.44); the optimizer learned 'disagree only when clearly warranted' so decisiveness and pushback stop trading off."}, {"id": "data_changelog_local_optimum", "label": "TLDR.md at local optimum on metric", "file_type": "rationale", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two independent DSPy runs (n=25 and n=73) found no candidate beating the shipped prompt, so further search was judged metric-bound rather than prompt-bound."}, {"id": "data_changelog_tldr_v0160", "label": "TLDR.md v0.16.0 unified prompt", "file_type": "concept", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_changelog_anti_helpfulness_rule", "label": "Anti-helpfulness rule (v0.9)", "file_type": "rationale", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RLHF rewards 'covering the bases', so unsolicited postscripts had to be forbidden explicitly; this single clause moved cursor compliance 73% to 100%."}, {"id": "data_changelog_diff_fence_rule", "label": "Diff-fence rule (v0.13)", "file_type": "rationale", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agents whose CLI auto-injects diff views were told to fence them so they count as code, not prose."}, {"id": "data_changelog_anti_metadata_rule", "label": "Anti-metadata rule (v0.10)", "file_type": "rationale", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forbids session_id/runId/diff-views in output; failed on hermes because the CLI appends them after generation."}, {"id": "data_changelog_hard_response_templates", "label": "Hard response templates (v0.5)", "file_type": "concept", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_changelog_per_prompt_shape_token_budget", "label": "Per-prompt-shape token budget table (v0.4)", "file_type": "concept", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_changelog_variance_shrinkage", "label": "Cross-agent variance shrinkage", "file_type": "concept", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_changelog_hermes_ceiling", "label": "Hermes structural ceiling (87%)", "file_type": "concept", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hermes CLI appends a review-diff block and session_id trailer after the LLM finishes, so no prompt-level rule can suppress them."}, {"id": "data_changelog_chat_unification", "label": "TLDR.chat.md merged into TLDR.md", "file_type": "concept", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two prompts differed only in default cap tightness; a separate file added install friction without behavioural delta."}, {"id": "data_changelog_precommitted_pass_criteria", "label": "Pre-committed pass criteria", "file_type": "rationale", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Criteria were fixed before the run to prevent post-hoc rationalisation of whichever variant happened to win."}, {"id": "data_changelog_override_section", "label": "Primacy-placed Override section", "file_type": "rationale", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V1's bluntness directive overrode the override clause; moving Override before Bluntness (lost-in-the-middle) restored 2/2 compliance."}, {"id": "data_changelog_regex_simplicity_rule", "label": "Regex-simplicity rule (v0.6)", "file_type": "rationale", "source_file": "data/changelog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The strict IPv4 regex tokenizes to 58 tokens against a 40-token cap, so agents were producing correct answers that could not fit; simplest-correct unblocked 7/8 agents."}], "edges": [{"source": "data_changelog_blunt_v0180", "target": "data_changelog_dspy_instruction_evolution", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "data/changelog.md", "source_location": null, "weight": 1.0}, {"source": "data_changelog_blunt_v0180", "target": "data_changelog_cross_model_held_out", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "data/changelog.md", "source_location": null, "weight": 1.0}, {"source": "data_changelog_cross_model_held_out", "target": "data_changelog_independent_judge_codex", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "data/changelog.md", "source_location": null, "weight": 1.0}, {"source": "data_changelog_cross_model_held_out", "target": "data_changelog_prepend_to_user_message", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "data/changelog.md", "source_location": null, "weight": 1.0}, {"source": "data_changelog_blunt_v0180", "target": "data_changelog_anti_contrarian", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_fi
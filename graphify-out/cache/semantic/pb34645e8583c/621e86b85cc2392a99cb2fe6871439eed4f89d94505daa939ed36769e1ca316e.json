{"nodes": [{"id": "data_philosophy_output_side_compression", "label": "Output-side compression thesis", "file_type": "rationale", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Input tokens got cheap via prompt caching while output stays billed at full rate and drives latency and reader attention, so compression effort belongs on the output side."}, {"id": "data_philosophy_caveman_inspiration", "label": "caveman (Brussee) inspiration", "file_type": "concept", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_philosophy_caveman_personification_problem", "label": "Caveman personification problem", "file_type": "concept", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Naming a stereotyped character pulls the model into that stereotype manifold, which degrades reasoning, costs persona tokens, and is unusable in production."}, {"id": "data_philosophy_register_not_character", "label": "Describe the discipline, not a character", "file_type": "rationale", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persona conditioning drags competence and trust; specifying a senior-engineer register keeps the density without the character."}, {"id": "data_philosophy_simulacrum_theory", "label": "Simulacrum theory of roleplay", "file_type": "concept", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_philosophy_persona_iq_coupling", "label": "Persona-IQ coupling (dumb-character drag)", "file_type": "concept", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_philosophy_tldr_thesis", "label": "The TLDR.md thesis", "file_type": "concept", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_philosophy_prose_tokens_outside_code_blocks", "label": "Prose tokens outside code blocks", "file_type": "concept", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counting code tokens would penalise an agent for correctly producing the requested artifact, and the compression that drives cost and latency is the prose around code."}, {"id": "data_philosophy_measurable_success_criteria", "label": "Bias toward measurable success criteria", "file_type": "rationale", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Be concise' has no self-check; 'max 16 words per sentence' does, which is why hard caps beat soft phrasing."}, {"id": "data_philosophy_few_shot_floor", "label": "Few-shot examples set the floor", "file_type": "rationale", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Example length anchors output length, so shrinking examples from 70 to 20 words moved real answers proportionally."}, {"id": "data_philosophy_brevity_improves_accuracy", "label": "Brevity constraints improve accuracy", "file_type": "rationale", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brevity constraints reportedly improved accuracy up to 26pp; verbose output creates more room to err. Not measured on this repo's style-focused bench."}, {"id": "data_philosophy_prompt_caching_asymmetry", "label": "Input/output cost asymmetry under caching", "file_type": "rationale", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cached input costs ~10% of uncached, so a 9KB prompt pays for itself within about three turns."}, {"id": "data_philosophy_hermes_ceiling", "label": "Hermes harness-bounded ceiling", "file_type": "concept", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_philosophy_additive_compatible", "label": "Additive-compatible scope clause", "file_type": "rationale", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declaring 'communication style only' lets the file append to existing personas and session contracts without overriding task or safety instructions."}, {"id": "data_philosophy_cite_shanahan_roleplay", "label": "Shanahan et al., Role play with large language models (2023)", "file_type": "paper", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_philosophy_cite_sharma_sycophancy", "label": "Sharma et al., Towards Understanding Sycophancy in Language Models (2023)", "file_type": "paper", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_philosophy_cite_ouyang_instructgpt", "label": "Ouyang et al., InstructGPT (NeurIPS 2022)", "file_type": "paper", "source_file": "data/philosophy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_philosophy_cite_wei_cot", "label": "Wei et al., Chain-of-Thought Prompting (NeurIPS 2022)", "file_